NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://postgres:REPLACE_WITH_LOCAL_PASSWORD@localhost:5432/pawpals_validation
APP_TOKEN_SECRET=replace-with-at-least-24-random-characters
DATA_ENCRYPTION_KEY=replace-with-at-least-24-random-characters

# Auth / verification
SESSION_TTL_HOURS=168
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
RESET_GRANT_TTL_MINUTES=10
REAUTH_GRANT_TTL_MINUTES=10
SENSITIVE_GRANT_TTL_MINUTES=10
# Development adapter only; never configure a fixed OTP in production.
DEV_OTP_CODE=123456

# Frozen/configurable MVP policy values
PAYMENT_HOLD_MINUTES=15
SETTLEMENT_HOLD_MINUTES=1440
CANCELLATION_CLAIM_WINDOW_MINUTES=1440
CUSTOMER_SELF_RESCHEDULE_MIN_NOTICE_MINUTES=1440
COMMISSION_RATE_BPS=500
MINIMUM_PAYOUT_AMOUNT=50000

# Payment provider
# Development ONLY: opt in BEFORE creating a new booking; MOCK does not move real money.
# Must remain false/unset in production. Changing this flag does not convert old MIDTRANS payments.
PAWPALS_ENABLE_MOCK_PAYMENTS=false
MIDTRANS_SERVER_KEY=
MIDTRANS_SNAP_URL=https://app.sandbox.midtrans.com/snap/v1/transactions
MIDTRANS_API_URL=https://api.sandbox.midtrans.com
# Development-only signature bypass; keep false in normal use.
ALLOW_UNVERIFIED_DEV_WEBHOOK=false

# Async/outbox
REDIS_URL=redis://localhost:6379


# Browser origin protection (comma-separated; MUST match HTTPS frontend origin behind proxy)
APP_ALLOWED_ORIGINS=https://pawpals.example

# Purpose-bound Twilio Verify (four DISTINCT services; no production fixed OTP)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID_PHONE_VERIFICATION=
TWILIO_VERIFY_SERVICE_SID_PASSWORD_RESET=
TWILIO_VERIFY_SERVICE_SID_PAYOUT_ACCOUNT_CHANGE=
TWILIO_VERIFY_SERVICE_SID_SENSITIVE_PROFILE_CHANGE=

# S3-compatible PRIVATE object storage. Use a bucket with public access blocked.
MEDIA_S3_ENDPOINT=https://s3.ap-southeast-1.amazonaws.com
MEDIA_S3_BUCKET=
MEDIA_S3_REGION=ap-southeast-1
MEDIA_S3_ACCESS_KEY_ID=
MEDIA_S3_SECRET_ACCESS_KEY=

# Notification/operations event consumer (POST webhook, HMAC + event_key dedup)
NOTIFICATION_WEBHOOK_URL=
NOTIFICATION_WEBHOOK_SECRET=

# Provider-neutral payout API adapter; must be implemented/tested by your chosen provider.
# POST /recipients/verify; POST /payouts; GET /payouts/:reference.
DISBURSEMENT_API_URL=
DISBURSEMENT_API_TOKEN=
DISBURSEMENT_PROVIDER=
