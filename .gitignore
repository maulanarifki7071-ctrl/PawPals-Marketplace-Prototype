
# PawPals - Git Ignore

# Dependencies
node_modules/

# Build output and cache
dist/
dist-ssr/
build/
.vite/
*.tsbuildinfo

# Environment variables and secrets
.env
.env.*
!.env.example
*.local
*.pem
*.key
*.p12
*.pfx

# Private media storage
.pawpals-local-media/

# Database backups
*.backup
*.dump
*.bak
*.sql.gz
database-backups/
backups/

# Project backups
FrontEnd_Backup*/
BackEnd_Backup*/
*_backup/
* copy.ts
* copy.tsx
* copy.cjs
tsconfig.backup.txt

# Distribution archives
*.zip
*.rar
*.7z

# Testing artifacts
coverage/
test-results/
playwright-report/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Editor configuration
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Operating system files
.DS_Store
Thumbs.db
desktop.ini

# Microsoft Office temporary files
~$*.docx
~$*.xlsx

# Archived documentation
/docs/archive/
