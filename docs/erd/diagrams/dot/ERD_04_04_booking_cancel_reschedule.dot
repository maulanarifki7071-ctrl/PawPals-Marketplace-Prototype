digraph schema {
graph [rankdir=TB, bgcolor="white", pad="0.35", nodesep="0.40", ranksep="0.8", splines=polyline, overlap=false];
node [shape=plain, fontname="DejaVu Sans"];
edge [color="#7d8c9a", arrowsize=0.6, penwidth=1.1, fontname="DejaVu Sans", fontsize=8];
"bookings" [label=<<TABLE BORDER="1" COLOR="#b6cbd1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#f7fafb"><TR><TD BGCOLOR="#a56f2f" COLSPAN="2" ALIGN="LEFT"><FONT COLOR="white" POINT-SIZE="12"><B>bookings</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">id</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#526276" POINT-SIZE="8">PK uuid</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">customer_account_id</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#526276" POINT-SIZE="8">FK uuid</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">vendor_id</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#526276" POINT-SIZE="8">FK uuid</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">vendor_service_id</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#526276" POINT-SIZE="8">FK uuid</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">status</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#526276" POINT-SIZE="8"> booking_status</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">scheduled_start_at</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#526276" POINT-SIZE="8"> timestamptz</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">total_amount</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#526276" POINT-SIZE="8"> bigint</FONT></TD></TR><TR><TD COLSPAN="2" ALIGN="LEFT"><FONT COLOR="#81909b" POINT-SIZE="8">+9 other fields</FONT></TD></TR></TABLE>>];
"booking_items" [label=<<TABLE BORDER="1" COLOR="#b6cbd1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#f7fafb"><TR><TD BGCOLOR="#a56f2f" COLSPAN="2" ALIGN="LEFT"><FONT COLOR="white" POINT-SIZE="12"><B>booking_items</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">id</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#526276" POINT-SIZE="8">PK uuid</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">booking_id</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#526276" POINT-SIZE="8">FK uuid</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">pet_id</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#526276" POINT-SIZE="8">FK uuid</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">service_package_id</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#526276" POINT-SIZE="8">FK uuid</FONT></TD></TR><TR><TD COLSPAN="2" ALIGN="LEFT"><FONT COLOR="#81909b" POINT-SIZE="8">+10 other fields</FONT></TD></TR></TABLE>>];
