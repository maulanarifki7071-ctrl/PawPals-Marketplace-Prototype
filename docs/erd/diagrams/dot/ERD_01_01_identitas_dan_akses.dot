digraph schema {
graph [rankdir=TB, bgcolor="white", pad="0.35", nodesep="0.40", ranksep="0.8", splines=polyline, overlap=false];
node [shape=plain, fontname="DejaVu Sans"];
edge [color="#7d8c9a", arrowsize=0.6, penwidth=1.1, fontname="DejaVu Sans", fontsize=8];
"accounts" [label=<<TABLE BORDER="1" COLOR="#b6cbd1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#f7fafb"><TR><TD BGCOLOR="#16827b" COLSPAN="2" ALIGN="LEFT"><FONT COLOR="white" POINT-SIZE="12"><B>accounts</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">id</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#526276" POINT-SIZE="8">PK uuid</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">status</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#526276" POINT-SIZE="8"> account_status</FONT></TD></TR><TR><TD COLSPAN="2" ALIGN="LEFT"><FONT COLOR="#81909b" POINT-SIZE="8">+6 other fields</FONT></TD></TR></TABLE>>];
"account_credentials" [label=<<TABLE BORDER="1" COLOR="#b6cbd1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#f7fafb"><TR><TD BGCOLOR="#16827b" COLSPAN="2" ALIGN="LEFT"><FONT COLOR="white" POINT-SIZE="12"><B>account_credentials</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">id</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#526276" POINT-SIZE="8">PK uuid</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">account_id</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#526276" POINT-SIZE="8">FK uuid</FONT></TD></TR><TR><TD COLSPAN="2" ALIGN="LEFT"><FONT COLOR="#81909b" POINT-SIZE="8">+5 other fields</FONT></TD></TR></TABLE>>];
"otp_challenges" [label=<<TABLE BORDER="1" COLOR="#b6cbd1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#f7fafb"><TR><TD BGCOLOR="#16827b" COLSPAN="2" ALIGN="LEFT"><FONT COLOR="white" POINT-SIZE="12"><B>otp_challenges</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">id</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#526276" POINT-SIZE="8">PK uuid</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">account_id</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#526276" POINT-SIZE="8">FK uuid</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">status</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#526276" POINT-SIZE="8"> otp_status</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">expires_at</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#526276" POINT-SIZE="8"> timestamptz</FONT></TD></TR><TR><TD COLSPAN="2" ALIGN="LEFT"><FONT COLOR="#81909b" POINT-SIZE="8">+6 other fields</FONT></TD></TR></TABLE>>];
"otp_delivery_attempts" [label=<<TABLE BORDER="1" COLOR="#b6cbd1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#f7fafb"><TR><TD BGCOLOR="#16827b" COLSPAN="2" ALIGN="LEFT"><FONT COLOR="white" POINT-SIZE="12"><B>otp_delivery_attempts</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">id</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#526276" POINT-SIZE="8">PK uuid</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">otp_challenge_id</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#526276" POINT-SIZE="8">FK uuid</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">status</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#526276" POINT-SIZE="8"> otp_delivery_status</FONT></TD></TR><TR><TD COLSPAN="2" ALIGN="LEFT"><FONT COLOR="#81909b" POINT-SIZE="8">+7 other fields</FONT></TD></TR></TABLE>>];
"auth_sessions" [label=<<TABLE BORDER="1" COLOR="#b6cbd1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#f7fafb"><TR><TD BGCOLOR="#16827b" COLSPAN="2" ALIGN="LEFT"><FONT COLOR="white" POINT-SIZE="12"><B>auth_sessions</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">id</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#526276" POINT-SIZE="8">PK uuid</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">account_id</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#526276" POINT-SIZE="8">FK uuid</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">status</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#526276" POINT-SIZE="8"> session_status</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">expires_at</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#526276" POINT-SIZE="8"> timestamptz</FONT></TD></TR><TR><TD COLSPAN="2" ALIGN="LEFT"><FONT COLOR="#81909b" POINT-SIZE="8">+6 other fields</FONT></TD></TR></TABLE>>];
"roles" [label=<<TABLE BORDER="1" COLOR="#b6cbd1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#f7fafb"><TR><TD BGCOLOR="#16827b" COLSPAN="2" ALIGN="LEFT"><FONT COLOR="white" POINT-SIZE="12"><B>roles</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">id</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#526276" POINT-SIZE="8">PK uuid</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">name</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#526276" POINT-SIZE="8"> varchar(120)</FONT></TD></TR><TR><TD COLSPAN="2" ALIGN="LEFT"><FONT COLOR="#81909b" POINT-SIZE="8">+3 other fields</FONT></TD></TR></TABLE>>];
"permissions" [label=<<TABLE BORDER="1" COLOR="#b6cbd1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#f7fafb"><TR><TD BGCOLOR="#16827b" COLSPAN="2" ALIGN="LEFT"><FONT COLOR="white" POINT-SIZE="12"><B>permissions</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">id</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#526276" POINT-SIZE="8">PK uuid</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">name</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#526276" POINT-SIZE="8"> varchar(150)</FONT></TD></TR><TR><TD COLSPAN="2" ALIGN="LEFT"><FONT COLOR="#81909b" POINT-SIZE="8">+4 other fields</FONT></TD></TR></TABLE>>];
"role_permissions" [label=<<TABLE BORDER="1" COLOR="#b6cbd1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#f7fafb"><TR><TD BGCOLOR="#16827b" COLSPAN="2" ALIGN="LEFT"><FONT COLOR="white" POINT-SIZE="12"><B>role_permissions</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">id</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#526276" POINT-SIZE="8">PK uuid</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">role_id</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#526276" POINT-SIZE="8">FK uuid</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">permission_id</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#526276" POINT-SIZE="8">FK uuid</FONT></TD></TR><TR><TD COLSPAN="2" ALIGN="LEFT"><FONT COLOR="#81909b" POINT-SIZE="8">+1 other fields</FONT></TD></TR></TABLE>>];
"account_role_assignments" [label=<<TABLE BORDER="1" COLOR="#b6cbd1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#f7fafb"><TR><TD BGCOLOR="#16827b" COLSPAN="2" ALIGN="LEFT"><FONT COLOR="white" POINT-SIZE="12"><B>account_role_assignments</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">id</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#526276" POINT-SIZE="8">PK uuid</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">account_id</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#526276" POINT-SIZE="8">FK uuid</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">role_id</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#526276" POINT-SIZE="8">FK uuid</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">assigned_by_account_id</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#526276" POINT-SIZE="8">FK uuid</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">status</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#526276" POINT-SIZE="8"> role_assignment_status</FONT></TD></TR><TR><TD COLSPAN="2" ALIGN="LEFT"><FONT COLOR="#81909b" POINT-SIZE="8">+2 other fields</FONT></TD></TR></TABLE>>];
"account_credentials" -> "accounts" ;
"otp_challenges" -> "accounts" ;
"otp_delivery_attempts" -> "otp_challenges" ;
"auth_sessions" -> "accounts" ;
"role_permissions" -> "roles" ;
"role_permissions" -> "permissions" ;
"account_role_assignments" -> "accounts" ;
"account_role_assignments" -> "roles" ;
}