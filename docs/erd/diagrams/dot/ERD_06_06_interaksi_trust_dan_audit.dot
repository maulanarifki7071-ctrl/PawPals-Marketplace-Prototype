"audit_logs" [label=<<TABLE BORDER="1" COLOR="#b6cbd1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#f7fafb"><TR><TD BGCOLOR="#6a57a4" COLSPAN="2" ALIGN="LEFT"><FONT COLOR="white" POINT-SIZE="12"><B>audit_logs</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">id</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#526276" POINT-SIZE="8">PK uuid</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">actor_account_id</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#526276" POINT-SIZE="8">FK uuid</FONT></TD></TR><TR><TD COLSPAN="2" ALIGN="LEFT"><FONT COLOR="#81909b" POINT-SIZE="8">+7 other fields</FONT></TD></TR></TABLE>>];
"sensitive_access_logs" [label=<<TABLE BORDER="1" COLOR="#b6cbd1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#f7fafb"><TR><TD BGCOLOR="#6a57a4" COLSPAN="2" ALIGN="LEFT"><FONT COLOR="white" POINT-SIZE="12"><B>sensitive_access_logs</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">id</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#526276" POINT-SIZE="8">PK uuid</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">actor_account_id</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#526276" POINT-SIZE="8">FK uuid</FONT></TD></TR><TR><TD COLSPAN="2" ALIGN="LEFT"><FONT COLOR="#81909b" POINT-SIZE="8">+5 other fields</FONT></TD></TR></TABLE>>];
"media_objects" [label=<<TABLE BORDER="1" COLOR="#b6cbd1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#f7fafb"><TR><TD BGCOLOR="#6a57a4" COLSPAN="2" ALIGN="LEFT"><FONT COLOR="white" POINT-SIZE="12"><B>media_objects</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">id</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#526276" POINT-SIZE="8">PK uuid</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">uploaded_by_account_id</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#526276" POINT-SIZE="8">FK uuid</FONT></TD></TR><TR><TD COLSPAN="2" ALIGN="LEFT"><FONT COLOR="#81909b" POINT-SIZE="8">+7 other fields</FONT></TD></TR></TABLE>>];
"booking_chat_read_states" -> "booking_chat_messages" ;
