digraph schema {
graph [rankdir=TB, bgcolor="white", pad="0.35", nodesep="0.40", ranksep="0.8", splines=polyline, overlap=false];
node [shape=plain, fontname="DejaVu Sans"];
edge [color="#7d8c9a", arrowsize=0.6, penwidth=1.1, fontname="DejaVu Sans", fontsize=8];
"payments" [label=<<TABLE BORDER="1" COLOR="#b6cbd1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#f7fafb"><TR><TD BGCOLOR="#a56f2f" COLSPAN="2" ALIGN="LEFT"><FONT COLOR="white" POINT-SIZE="12"><B>payments</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">id</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#526276" POINT-SIZE="8">PK uuid</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">booking_id</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#526276" POINT-SIZE="8">FK uuid</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">amount</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#526276" POINT-SIZE="8"> bigint</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">status</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#526276" POINT-SIZE="8"> payment_status</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">expires_at</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#526276" POINT-SIZE="8"> timestamptz</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">paid_at</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#526276" POINT-SIZE="8"> timestamptz</FONT></TD></TR><TR><TD COLSPAN="2" ALIGN="LEFT"><FONT COLOR="#81909b" POINT-SIZE="8">+8 other fields</FONT></TD></TR></TABLE>>];
"payment_events" [label=<<TABLE BORDER="1" COLOR="#b6cbd1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#f7fafb"><TR><TD BGCOLOR="#a56f2f" COLSPAN="2" ALIGN="LEFT"><FONT COLOR="white" POINT-SIZE="12"><B>payment_events</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">id</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#526276" POINT-SIZE="8">PK uuid</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">payment_id</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#526276" POINT-SIZE="8">FK uuid</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">event_type</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#526276" POINT-SIZE="8"> varchar(100)</FONT></TD></TR><TR><TD COLSPAN="2" ALIGN="LEFT"><FONT COLOR="#81909b" POINT-SIZE="8">+5 other fields</FONT></TD></TR></TABLE>>];
"refunds" [label=<<TABLE BORDER="1" COLOR="#b6cbd1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#f7fafb"><TR><TD BGCOLOR="#a56f2f" COLSPAN="2" ALIGN="LEFT"><FONT COLOR="white" POINT-SIZE="12"><B>refunds</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">id</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#526276" POINT-SIZE="8">PK uuid</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">payment_id</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#526276" POINT-SIZE="8">FK uuid</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">initiated_by_account_id</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#526276" POINT-SIZE="8">FK uuid</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">status</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#526276" POINT-SIZE="8"> refund_status</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">amount</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#526276" POINT-SIZE="8"> bigint</FONT></TD></TR><TR><TD COLSPAN="2" ALIGN="LEFT"><FONT COLOR="#81909b" POINT-SIZE="8">+11 other fields</FONT></TD></TR></TABLE>>];
"refund_attempts" [label=<<TABLE BORDER="1" COLOR="#b6cbd1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#f7fafb"><TR><TD BGCOLOR="#a56f2f" COLSPAN="2" ALIGN="LEFT"><FONT COLOR="white" POINT-SIZE="12"><B>refund_attempts</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">id</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#526276" POINT-SIZE="8">PK uuid</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">refund_id</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#526276" POINT-SIZE="8">FK uuid</FONT></TD></TR><TR><TD COLSPAN="2" ALIGN="LEFT"><FONT COLOR="#81909b" POINT-SIZE="8">+5 other fields</FONT></TD></TR></TABLE>>];
"ledger_entries" [label=<<TABLE BORDER="1" COLOR="#b6cbd1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#f7fafb"><TR><TD BGCOLOR="#a56f2f" COLSPAN="2" ALIGN="LEFT"><FONT COLOR="white" POINT-SIZE="12"><B>ledger_entries</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">id</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#526276" POINT-SIZE="8">PK uuid</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">vendor_id</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#526276" POINT-SIZE="8">FK uuid</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">booking_id</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#526276" POINT-SIZE="8">FK uuid</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">payment_id</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#526276" POINT-SIZE="8">FK uuid</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">refund_id</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#526276" POINT-SIZE="8">FK uuid</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">amount_signed</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#526276" POINT-SIZE="8"> bigint</FONT></TD></TR><TR><TD COLSPAN="2" ALIGN="LEFT"><FONT COLOR="#81909b" POINT-SIZE="8">+5 other fields</FONT></TD></TR></TABLE>>];
"settlement_items" [label=<<TABLE BORDER="1" COLOR="#b6cbd1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#f7fafb"><TR><TD BGCOLOR="#a56f2f" COLSPAN="2" ALIGN="LEFT"><FONT COLOR="white" POINT-SIZE="12"><B>settlement_items</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">id</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#526276" POINT-SIZE="8">PK uuid</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">vendor_id</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#526276" POINT-SIZE="8">FK uuid</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">booking_id</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#526276" POINT-SIZE="8">FK uuid</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">origin_ledger_entry_id</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#526276" POINT-SIZE="8">FK uuid</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">status</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#526276" POINT-SIZE="8"> settlement_status</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">amount_signed</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#526276" POINT-SIZE="8"> bigint</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">hold_until</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#526276" POINT-SIZE="8"> timestamptz</FONT></TD></TR><TR><TD COLSPAN="2" ALIGN="LEFT"><FONT COLOR="#81909b" POINT-SIZE="8">+7 other fields</FONT></TD></TR></TABLE>>];
"settlement_status_history" [label=<<TABLE BORDER="1" COLOR="#b6cbd1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#f7fafb"><TR><TD BGCOLOR="#a56f2f" COLSPAN="2" ALIGN="LEFT"><FONT COLOR="white" POINT-SIZE="12"><B>settlement_status_history</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">id</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#526276" POINT-SIZE="8">PK uuid</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">settlement_item_id</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#526276" POINT-SIZE="8">FK uuid</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">actor_account_id</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#526276" POINT-SIZE="8">FK uuid</FONT></TD></TR><TR><TD COLSPAN="2" ALIGN="LEFT"><FONT COLOR="#81909b" POINT-SIZE="8">+4 other fields</FONT></TD></TR></TABLE>>];
"vendor_payout_accounts" [label=<<TABLE BORDER="1" COLOR="#b6cbd1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#f7fafb"><TR><TD BGCOLOR="#a56f2f" COLSPAN="2" ALIGN="LEFT"><FONT COLOR="white" POINT-SIZE="12"><B>vendor_payout_accounts</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">id</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#526276" POINT-SIZE="8">PK uuid</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">vendor_id</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#526276" POINT-SIZE="8">FK uuid</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">account_number_last4</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#526276" POINT-SIZE="8"> varchar(4)</FONT></TD></TR><TR><TD COLSPAN="2" ALIGN="LEFT"><FONT COLOR="#81909b" POINT-SIZE="8">+9 other fields</FONT></TD></TR></TABLE>>];
"payouts" [label=<<TABLE BORDER="1" COLOR="#b6cbd1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#f7fafb"><TR><TD BGCOLOR="#a56f2f" COLSPAN="2" ALIGN="LEFT"><FONT COLOR="white" POINT-SIZE="12"><B>payouts</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">id</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#526276" POINT-SIZE="8">PK uuid</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">vendor_id</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#526276" POINT-SIZE="8">FK uuid</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">payout_account_id</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#526276" POINT-SIZE="8">FK uuid</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">status</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#526276" POINT-SIZE="8"> payout_status</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">total_amount</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#526276" POINT-SIZE="8"> bigint</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">paid_at</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#526276" POINT-SIZE="8"> timestamptz</FONT></TD></TR><TR><TD COLSPAN="2" ALIGN="LEFT"><FONT COLOR="#81909b" POINT-SIZE="8">+9 other fields</FONT></TD></TR></TABLE>>];
"payout_items" [label=<<TABLE BORDER="1" COLOR="#b6cbd1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#f7fafb"><TR><TD BGCOLOR="#a56f2f" COLSPAN="2" ALIGN="LEFT"><FONT COLOR="white" POINT-SIZE="12"><B>payout_items</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">id</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#526276" POINT-SIZE="8">PK uuid</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">payout_id</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#526276" POINT-SIZE="8">FK uuid</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">settlement_item_id</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#526276" POINT-SIZE="8">FK uuid</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">amount_signed</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#526276" POINT-SIZE="8"> bigint</FONT></TD></TR><TR><TD COLSPAN="2" ALIGN="LEFT"><FONT COLOR="#81909b" POINT-SIZE="8">+2 other fields</FONT></TD></TR></TABLE>>];
"payout_events" [label=<<TABLE BORDER="1" COLOR="#b6cbd1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#f7fafb"><TR><TD BGCOLOR="#a56f2f" COLSPAN="2" ALIGN="LEFT"><FONT COLOR="white" POINT-SIZE="12"><B>payout_events</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">id</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#526276" POINT-SIZE="8">PK uuid</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">payout_id</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#526276" POINT-SIZE="8">FK uuid</FONT></TD></TR><TR><TD COLSPAN="2" ALIGN="LEFT"><FONT COLOR="#81909b" POINT-SIZE="8">+5 other fields</FONT></TD></TR></TABLE>>];
"payout_status_history" [label=<<TABLE BORDER="1" COLOR="#b6cbd1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#f7fafb"><TR><TD BGCOLOR="#a56f2f" COLSPAN="2" ALIGN="LEFT"><FONT COLOR="white" POINT-SIZE="12"><B>payout_status_history</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">id</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#526276" POINT-SIZE="8">PK uuid</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">payout_id</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#526276" POINT-SIZE="8">FK uuid</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">actor_account_id</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#526276" POINT-SIZE="8">FK uuid</FONT></TD></TR><TR><TD COLSPAN="2" ALIGN="LEFT"><FONT COLOR="#81909b" POINT-SIZE="8">+4 other fields</FONT></TD></TR></TABLE>>];
"payment_events" -> "payments" ;
"refunds" -> "payments" ;
"refund_attempts" -> "refunds" ;
"ledger_entries" -> "payments" ;
"ledger_entries" -> "refunds" ;
"settlement_items" -> "ledger_entries" ;
"settlement_status_history" -> "settlement_items" ;
"payouts" -> "vendor_payout_accounts" ;
"payout_items" -> "payouts" ;
"payout_items" -> "settlement_items" ;
"payout_events" -> "payouts" ;
"payout_status_history" -> "payouts" ;
}